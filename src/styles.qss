/* ═══════════════════════════════════════════════════════════════
   PDF Converter — Catppuccin Mocha Theme (QSS)
   ═══════════════════════════════════════════════════════════════ */

/* ── Palette ────────────────────────────────────────────────────
   Base:     #1e1e2e     Mantle:   #181825     Crust:    #11111b
   Surface0: #313244     Surface1: #45475a     Surface2: #585b70
   Overlay0: #6c7086     Overlay1: #7f849c     Overlay2: #9399b2
   Subtext0: #a6adc8     Subtext1: #bac2de     Text:     #cdd6f4
   Blue:     #89b4fa     Lavender: #b4befe     Sapphire: #74c7ec
   Green:    #a6e3a1     Red:      #f38ba8     Peach:    #fab387
   ─────────────────────────────────────────────────────────────── */

QMainWindow {
    background-color: #1e1e2e;
}

/* ── Toolbar ─────────────────────────────────────────────────── */
QToolBar {
    background-color: #181825;
    border-bottom: 1px solid #313244;
    padding: 4px 8px;
    spacing: 6px;
}

QToolBar QToolButton {
    color: #cdd6f4;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 12px;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    font-size: 13px;
}

QToolBar QToolButton:hover {
    background-color: #313244;
    border-color: #45475a;
}

QToolBar QToolButton:pressed {
    background-color: #45475a;
}

QToolBar QToolButton::menu-indicator {
    subcontrol-position: right center;
    subcontrol-origin: padding;
    width: 12px;
    image: none;
}

QToolBar QPushButton {
    color: #cdd6f4;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 12px;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    font-size: 13px;
}

QToolBar QPushButton:hover {
    background-color: #313244;
    border-color: #45475a;
}

QToolBar QPushButton:pressed {
    background-color: #45475a;
}

/* ── Toolbar Separator ───────────────────────────────────────── */
QToolBar::separator {
    width: 1px;
    background-color: #313244;
    margin: 4px 6px;
}

/* ── ComboBox (Theme Selector) ───────────────────────────────── */
QComboBox {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 5px 28px 5px 12px;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    font-size: 13px;
    min-width: 180px;
}

QComboBox:hover {
    border-color: #89b4fa;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    selection-background-color: #45475a;
    selection-color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px;
    outline: none;
}

/* ── Splitter ────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #313244;
    width: 1px;
}

QSplitter::handle:hover {
    background-color: #89b4fa;
}

/* ── Status Bar ──────────────────────────────────────────────── */
QStatusBar {
    background-color: #181825;
    color: #a6adc8;
    border-top: 1px solid #313244;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    font-size: 12px;
    padding: 2px 8px;
}

QStatusBar QLabel {
    color: #a6adc8;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    font-size: 12px;
    padding: 0 4px;
}

QStatusBar::item {
    border: none;
}

/* ── Scrollbars ──────────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: #1e1e2e;
    width: 8px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #45475a;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #585b70;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #1e1e2e;
    height: 8px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #45475a;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #585b70;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ── DockWidget (Find/Replace) ───────────────────────────────── */
QDockWidget {
    color: #cdd6f4;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    titlebar-close-icon: none;
}

QDockWidget::title {
    background-color: #181825;
    padding: 6px;
    border-bottom: 1px solid #313244;
}

/* ── Line Edit ───────────────────────────────────────────────── */
QLineEdit {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px 10px;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    font-size: 13px;
    selection-background-color: #585b70;
}

QLineEdit:focus {
    border-color: #89b4fa;
}

/* ── Menu (Highlight Colors) ─────────────────────────────────── */
QMenu {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
}

QMenu::item {
    padding: 6px 14px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #45475a;
    color: #cdd6f4;
}

QMenu::separator {
    height: 1px;
    background: #313244;
    margin: 4px 8px;
}

/* ── Dialog ──────────────────────────────────────────────────── */
QDialog {
    background-color: #1e1e2e;
    color: #cdd6f4;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
}

/* ── Message Box ─────────────────────────────────────────────── */
QMessageBox {
    background-color: #1e1e2e;
    color: #cdd6f4;
}

QMessageBox QPushButton {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px 16px;
    min-width: 80px;
}

QMessageBox QPushButton:hover {
    background-color: #45475a;
}

/* ── Preview Header ──────────────────────────────────────────── */
#preview_header {
    background-color: #181825;
    border-bottom: 1px solid #313244;
    padding: 4px 12px;
}

#preview_header QLabel {
    color: #cdd6f4;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 600;
}

#preview_header QPushButton {
    background-color: transparent;
    color: #a6adc8;
    border: 1px solid #45475a;
    border-radius: 5px;
    padding: 3px 8px;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    font-size: 12px;
}

#preview_header QPushButton:hover {
    background-color: #313244;
    color: #cdd6f4;
    border-color: #89b4fa;
}

/* ── Tooltip ─────────────────────────────────────────────────── */
QToolTip {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    font-size: 12px;
}

/* ── GroupBox ────────────────────────────────────────────────── */
QGroupBox {
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 8px;
    margin-top: 8px;
    padding-top: 12px;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

/* ── Label (Theme Label in toolbar) ──────────────────────────── */
#theme_label {
    color: #a6adc8;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
    border: none;
    padding: 0 2px;
}

/* ── Status bar permanent labels ─────────────────────────────── */
#status_save {
    color: #a6e3a1;
    font-weight: 600;
}

#status_mode {
    color: #89b4fa;
}

#status_cursor {
    color: #a6adc8;
}

#status_words {
    color: #a6adc8;
}

#status_encoding {
    color: #a6adc8;
}

#status_filetype {
    color: #a6adc8;
}

#status_zoom {
    color: #a6adc8;
}
